# ===== PixelSub configuration =====
# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (required) ---
# Postgres connection string from Neon / Railway / Supabase / etc.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Session (required in production) ---
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- First admin user ---
# Only used the very first time the database is empty, to create the admin.
# After that, change the password from the admin panel and you may remove these.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Runtime ---
# Set to "production" when deploying. Enables secure cookies and requires SESSION_SECRET.
NODE_ENV=development
PORT=3000
